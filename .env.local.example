# Copy this file to .env.local and fill in your own values. .env.local is gitignored --
# never commit real credentials.

NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/ai_document_intelligence

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_VISION_MODEL=qwen2.5vl:7b        # optional, defaults shown
# E5_SERVICE_URL=http://127.0.0.1:8001    # optional, defaults shown

# --- Email inbox checking (POST /api/email/check-inbox) ---
# Optional: only required if you use the email-ingestion feature. Each developer
# configures their own mailbox here; nothing mailbox-specific is hardcoded in the app.
#
# For a Microsoft 365 mailbox (e.g. techgrit.com), you need an app password, not your
# regular login password -- Microsoft disabled legacy IMAP basic auth with your normal
# password for most tenants. Generate one at https://mysignins.microsoft.com/security-info
# ("Add sign-in method" -> "App password"), if your org's tenant allows it. If IMAP is
# blocked entirely for your tenant, this feature won't connect -- see
# docs/superpowers/specs/2026-07-28-email-inbox-ingestion-design.md for why, and what the
# fallback would be.
EMAIL_IMAP_HOST=outlook.office365.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=you@techgrit.com
EMAIL_IMAP_PASSWORD=your-app-password
# EMAIL_IMAP_MAILBOX=INBOX                # optional, defaults shown
# EMAIL_ATTACHMENT_DIR=data/incoming      # optional, defaults shown
# EMAIL_SUBJECT_FILTER=invoice             # optional -- only process unread messages
                                           # whose subject contains this (case-insensitive).
                                           # Unset means every unread message with a
                                           # matching attachment is a candidate.
